rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  // Prototype data model:
  // Verified Firebase Auth token: administrator:true, set only by trusted operator.
  // Trusted courseAccessApproved:true grants verified teachers their own courses.
  // Explicitly provisioned administrators manage all courses.
  // courses/{id}: ownerUid:string (immutable), title:string<=100,
  //   version:int>=0, dates:list<=1000. Regular owners filter ownerUid; administrators may list all.
  // courses/{id}/private/config: students:list<=5000, groups:list<=30, demo:bool.
  // courses/{id}/sessions/{date}: date, cancelled<=200, roster<=5000,
  //   marks:map of student ID -> status, reports:map<=30. Owner only.
  // channels/{sha256 bearer token}: ownerUid, courseId, groupId (immutable),
  //   title, group (no token), students<=5000, active:bool. Never enumerate.
  // channels/{hash}/lessons/{date}: ownerUid, courseId, groupId, date,
  //   cancelled, roster, rosterIds, marks, reportedAt:timestamp|null.
  // Groups can only replace their own complete marks + server timestamp.
  // A channel path is a bearer credential, just like the existing secret link.
  // Read-only sharing: shares/{hash}: ownerUid,courseId; exact get only.
  // viewers/{uid}/courses/{course}: shareHash; binds an authenticated reader.
  // courses/{id}/public/summary: title, students<=5000, sanitized groups<=30.
  // publicSessions/{date}: date,cancelled,roster,marks,groupId,reportedAt.
  // private/links: hashes map<=30 (never disclosed to viewers).
  // private/share: raw token string64..160 (managers only).
  function signed() { return request.auth != null; }
  function verified() {
   return signed() && request.auth.token.email_verified == true
    && request.auth.token.firebase.sign_in_provider != 'anonymous';
  }
  // Manual approval is account-specific, privileged provisioning, not email verification.
  function approvedAccount() {
   return (verified() && (request.auth.token.get('courseAccessApproved', false) == true
     || request.auth.token.get('administrator', false) == true)) || (signed()
    && request.auth.token.firebase.sign_in_provider != 'anonymous'
    && request.auth.token.administrator == true
    && request.auth.token.manualAccessApproved == true);
  }
  function administrator() { return approvedAccount() && request.auth.token.administrator == true; }
  function manages(uid) { return approvedAccount() && (request.auth.uid==uid || administrator()); }
  function text(v,max) { return v is string && v.size() <= max; }
  function id(v) { return v is string && v.matches('^[A-Za-z0-9-]{1,128}$'); }
  function date(v) { return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
  function owner(courseId) {
   return manages(get(/databases/$(database)/documents/courses/$(courseId)).data.ownerUid);
  }
  function ownerAfter(courseId) {
   return manages(getAfter(/databases/$(database)/documents/courses/$(courseId)).data.ownerUid);
  }
  function validCourse(d) {
   return d.keys().hasAll(['ownerUid','title','version','dates']) && d.keys().hasOnly(['ownerUid','title','version','dates'])
    && id(d.ownerUid) && text(d.title,100) && d.title.size()>0
    && d.version is int && d.version>=0 && d.version<1000000000
    && d.dates is list && d.dates.size()<=1000 && d.dates.toSet().size()==d.dates.size();
  }
  function validConfig(d) {
   return d.keys().hasAll(['students','groups','demo']) && d.keys().hasOnly(['students','groups','demo'])
    && d.students is list && d.students.size()<=5000
    && d.groups is list && d.groups.size()<=30 && d.demo is bool;
  }
  function marks(d) {
   return d is map && d.size()<=5000 && d.values().hasOnly(['anwesend','abwesend','entschuldigt']);
  }
  function validSession(d,day) {
   return d.keys().hasAll(['date','cancelled','roster','marks','reports']) && d.keys().hasOnly(['date','cancelled','roster','marks','reports'])
    && date(day) && d.date==day && text(d.cancelled,200)
    && d.roster is list && d.roster.size()<=5000 && marks(d.marks)
    && d.reports is map && d.reports.size()<=30;
  }
  function validGroup(g,groupId) {
   return g is map && g.keys().hasAll(['id','name','leader']) && g.keys().hasOnly(['id','name','leader','leaderId'])
    && g.id==groupId && text(g.name,100) && g.name.size()>0 && text(g.leader,150)
    && (!('leaderId' in g) || id(g.leaderId));
  }
  function validChannel(d,hash) {
   return hash.matches('^[a-f0-9]{64}$')
    && d.keys().hasAll(['ownerUid','courseId','groupId','title','group','students','active'])
    && d.keys().hasOnly(['ownerUid','courseId','groupId','title','group','students','active'])
    && id(d.ownerUid) && id(d.courseId) && id(d.groupId) && text(d.title,100)
    && validGroup(d.group,d.groupId) && d.students is list && d.students.size()<=5000 && d.active is bool;
  }
  function validLesson(d,day) {
   return d.keys().hasAll(['ownerUid','courseId','groupId','date','cancelled','roster','rosterIds','marks','reportedAt'])
    && d.keys().hasOnly(['ownerUid','courseId','groupId','date','cancelled','roster','rosterIds','marks','reportedAt'])
    && id(d.ownerUid) && id(d.courseId) && id(d.groupId) && date(day) && d.date==day && text(d.cancelled,200)
    && d.roster is list && d.roster.size()<=5000
    && d.rosterIds is list && d.rosterIds.size()==d.roster.size() && d.rosterIds.toSet().size()==d.rosterIds.size()
    && marks(d.marks) && d.marks.keys().hasOnly(d.rosterIds)
    && (d.reportedAt==null || (d.reportedAt is timestamp && d.reportedAt<=request.time));
  }
  function activeChannel(hash) {
   let parent=get(/databases/$(database)/documents/channels/$(hash));
   return signed() && parent.data.active==true
    && get(/databases/$(database)/documents/courses/$(parent.data.courseId)).data.ownerUid==parent.data.ownerUid;
  }
  function boundToChannel(d,hash) {
   let parent=getAfter(/databases/$(database)/documents/channels/$(hash));
   return d.courseId==parent.data.courseId && d.groupId==parent.data.groupId && d.ownerUid==parent.data.ownerUid;
  }
  function activeShare(hash,courseId) {
   let share=get(/databases/$(database)/documents/shares/$(hash)).data;
   return share.courseId==courseId
    && get(/databases/$(database)/documents/courses/$(courseId)).data.ownerUid==share.ownerUid;
  }
  function viewer(courseId) {
   return signed() && activeShare(get(/databases/$(database)/documents/viewers/$(request.auth.uid)/courses/$(courseId)).data.shareHash,courseId);
  }
  function validSummary(d) {
   return d.keys().hasAll(['title','students','groups']) && d.keys().hasOnly(['title','students','groups'])
    && text(d.title,100) && d.students is list && d.students.size()<=5000
    && d.groups is list && d.groups.size()<=30;
  }
  function validPublicSession(d,day) {
   return d.keys().hasAll(['date','cancelled','roster','marks','groupId','reportedAt'])
    && d.keys().hasOnly(['date','cancelled','roster','marks','groupId','reportedAt'])
    && date(day) && d.date==day && text(d.cancelled,200) && d.roster is list && d.roster.size()<=5000
    && marks(d.marks) && (d.groupId=='' || id(d.groupId))
    && (d.reportedAt==null || (d.reportedAt is timestamp && d.reportedAt<=request.time));
  }
  function mirroredReport(d,day) {
   let mirror=getAfter(/databases/$(database)/documents/courses/$(d.courseId)/publicSessions/$(day)).data;
   return mirror.groupId==d.groupId && mirror.reportedAt==request.time
    && !mirror.marks.diff(d.marks).affectedKeys().hasAny(d.rosterIds);
  }
  function sharedReport(d,day) {
   return !exists(/databases/$(database)/documents/courses/$(d.courseId)/private/share) || mirroredReport(d,day);
  }
  function groupMirror(courseId,day) {
   let d=request.resource.data;
   let hash=get(/databases/$(database)/documents/courses/$(courseId)/private/links).data.hashes[d.groupId];
   let lesson=getAfter(/databases/$(database)/documents/channels/$(hash)/lessons/$(day)).data;
   return activeChannel(hash) && lesson.courseId==courseId && lesson.groupId==d.groupId
    && lesson.reportedAt==request.time && d.reportedAt==request.time
    && d.diff(resource.data).affectedKeys().hasOnly(['marks','groupId','reportedAt'])
    && d.marks.diff(resource.data.marks).affectedKeys().hasOnly(lesson.rosterIds)
    && !d.marks.diff(lesson.marks).affectedKeys().hasAny(lesson.rosterIds);
  }
  match /shares/{hash} {
   allow get: if (approvedAccount() && resource==null) || (signed() && activeShare(hash,resource.data.courseId));
   allow list,update: if false;
   allow create: if hash.matches('^[a-f0-9]{64}$')
    && request.resource.data.keys().hasAll(['ownerUid','courseId']) && request.resource.data.keys().hasOnly(['ownerUid','courseId'])
    && id(request.resource.data.courseId) && id(request.resource.data.ownerUid)
    && owner(request.resource.data.courseId)
    && request.resource.data.ownerUid==get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.ownerUid;
   allow delete: if manages(resource.data.ownerUid);
  }
  match /viewers/{uid}/courses/{courseId} {
   allow get,delete: if signed() && request.auth.uid==uid;
   allow list: if false;
   allow create,update: if signed() && request.auth.uid==uid
    && request.resource.data.keys().hasAll(['shareHash']) && request.resource.data.keys().hasOnly(['shareHash'])
    && request.resource.data.shareHash is string && request.resource.data.shareHash.matches('^[a-f0-9]{64}$')
    && activeShare(request.resource.data.shareHash,courseId);
  }
  match /courses/{courseId} {
   allow read: if manages(resource.data.ownerUid);
   allow create: if approvedAccount() && id(courseId) && validCourse(request.resource.data)
    && request.resource.data.ownerUid==request.auth.uid && request.resource.data.version==0;
   allow update: if owner(courseId) && validCourse(request.resource.data)
    && request.resource.data.ownerUid==resource.data.ownerUid && request.resource.data.version==resource.data.version+1;
   // Delete the root and private roster together. Active class links require an existing course.
   allow delete: if owner(courseId) && !existsAfter(/databases/$(database)/documents/courses/$(courseId)/private/config);
   match /private/{configId} {
    allow read: if configId in ['config','links','share'] && owner(courseId);
    allow create,update: if configId=='config' && ownerAfter(courseId) && validConfig(request.resource.data);
    allow create,update: if configId=='links' && ownerAfter(courseId)
     && request.resource.data.keys().hasAll(['hashes']) && request.resource.data.keys().hasOnly(['hashes'])
     && request.resource.data.hashes is map && request.resource.data.hashes.size()<=30;
    allow create,update: if configId=='share' && owner(courseId)
     && request.resource.data.keys().hasAll(['token']) && request.resource.data.keys().hasOnly(['token'])
     && request.resource.data.token is string && request.resource.data.token.matches('^[A-Za-z0-9-]{64,160}$');
    allow delete: if configId in ['links','share'] && owner(courseId);
    allow delete: if configId=='config' && owner(courseId) && !existsAfter(/databases/$(database)/documents/courses/$(courseId));
   }
   match /public/{summaryId} {
    allow read: if summaryId=='summary' && (owner(courseId) || viewer(courseId));
    allow create,update: if summaryId=='summary' && ownerAfter(courseId) && validSummary(request.resource.data);
    allow delete: if summaryId=='summary' && owner(courseId);
   }
   match /publicSessions/{day} {
    allow read: if owner(courseId) || viewer(courseId);
    allow create: if ownerAfter(courseId) && validPublicSession(request.resource.data,day);
    allow update: if validPublicSession(request.resource.data,day) && (ownerAfter(courseId) || groupMirror(courseId,day));
    allow delete: if owner(courseId);
   }
   match /sessions/{day} {
    allow read: if owner(courseId);
    allow create,update: if ownerAfter(courseId) && validSession(request.resource.data,day);
    allow delete: if owner(courseId);
   }
  }
  match /channels/{hash} {
   // A known high-entropy ID grants get access; anonymous collection scans cannot discover IDs.
   allow get: if (approvedAccount() && resource==null) || manages(resource.data.ownerUid) || activeChannel(hash);
   allow list: if manages(resource.data.ownerUid);
   allow create: if approvedAccount() && validChannel(request.resource.data,hash)
    && request.resource.data.ownerUid==getAfter(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.ownerUid && ownerAfter(request.resource.data.courseId);
   allow update: if manages(resource.data.ownerUid)
    && ownerAfter(resource.data.courseId) && validChannel(request.resource.data,hash)
    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerUid','courseId','groupId']);
   allow delete: if manages(resource.data.ownerUid) && owner(resource.data.courseId);
   match /lessons/{day} {
    allow read: if (approvedAccount() && (resource==null || manages(resource.data.ownerUid))) || activeChannel(hash);
    allow create: if approvedAccount() && validLesson(request.resource.data,day)
     && request.resource.data.ownerUid==getAfter(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.ownerUid && ownerAfter(request.resource.data.courseId)
     && boundToChannel(request.resource.data,hash);
    allow update: if validLesson(request.resource.data,day) && (
     (manages(resource.data.ownerUid) && ownerAfter(resource.data.courseId)
      && boundToChannel(request.resource.data,hash)
      && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerUid','courseId','groupId','date']))
     || (activeChannel(hash) && resource.data.cancelled=='' && resource.data.rosterIds.size()>0
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['marks','reportedAt'])
      && request.resource.data.marks.keys().hasAll(resource.data.rosterIds)
      && request.resource.data.reportedAt==request.time && sharedReport(request.resource.data,day)));
    allow delete: if manages(resource.data.ownerUid) && owner(resource.data.courseId);
   }
  }
  match /{document=**} { allow read,write: if false; }
 }
}
